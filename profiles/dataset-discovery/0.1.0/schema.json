{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://la3d-llm-agents.github.io/ns/profiles/dataset-discovery/0.1.0/schema.json",
  "title": "Dataset discovery registry 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile_version": {
      "const": "0.1.0"
    },
    "datasets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataset"
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true
    }
  },
  "required": [
    "profile_version",
    "datasets"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "url": {
      "type": "string",
      "maxLength": 2000,
      "format": "uri",
      "pattern": "^https://[^\\s/?#@]+(/[^\\s?#]*)?$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "arguments": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,99}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 2000
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool_name": {
          "$ref": "#/$defs/id"
        },
        "arguments": {
          "$ref": "#/$defs/arguments"
        }
      },
      "required": [
        "tool_name",
        "arguments"
      ]
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "$ref": "#/$defs/url"
            }
          },
          "required": [
            "url"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resource_id": {
              "$ref": "#/$defs/id"
            },
            "tool": {
              "$ref": "#/$defs/tool"
            }
          },
          "required": [
            "resource_id",
            "tool"
          ]
        }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "observed_at": {
          "$ref": "#/$defs/time"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "source",
        "observed_at"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "curator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          },
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true
        }
      },
      "required": [
        "curator",
        "observations"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "$ref": "#/$defs/id"
        },
        "source_shortname": {
          "$ref": "#/$defs/id"
        },
        "semantic_inspections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool"
          },
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true
        },
        "version_inspection": {
          "$ref": "#/$defs/tool"
        }
      },
      "required": [
        "resource_id",
        "source_shortname",
        "semantic_inspections",
        "version_inspection"
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "iri": {
          "$ref": "#/$defs/url"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "kind": {
          "const": "knowledge-graph"
        },
        "named_graph": {
          "$ref": "#/$defs/url"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "access_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "source_version": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "observation": {
              "$ref": "#/$defs/observation"
            }
          },
          "required": [
            "value",
            "observation"
          ]
        },
        "loaded_at": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "$ref": "#/$defs/time"
            },
            "observation": {
              "$ref": "#/$defs/observation"
            }
          },
          "required": [
            "value",
            "observation"
          ]
        }
      },
      "required": [
        "id",
        "iri",
        "label",
        "description",
        "kind",
        "named_graph",
        "tags",
        "access_bindings",
        "provenance"
      ]
    }
  }
}
