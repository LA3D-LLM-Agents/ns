PREFIX eco: <https://la3d-llm-agents.github.io/ns/eco#>
PREFIX ex: <urn:eco:example:>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK { ex:pad eco:hasService ?s . ?s a eco:MCPEndpoint ; eco:transport "streamable-http" ; eco:serviceURL "https://pad.crc.nd.edu/mcp"^^xsd:anyURI . FILTER NOT EXISTS { ex:pad-openapi a eco:MCPEndpoint } }
