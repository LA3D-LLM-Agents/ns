PREFIX eco: <https://la3d-llm-agents.github.io/ns/eco#>
PREFIX ex: <urn:eco:example:>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK { ex:wiki a eco:Bundle ; eco:hasCapability ex:explain ; eco:consumptionMode eco:CloneAndInvoke . ex:explain eco:providedBy ex:wiki . FILTER NOT EXISTS { ex:wiki a eco:Connector } }
