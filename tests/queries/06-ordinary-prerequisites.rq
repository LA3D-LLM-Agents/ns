PREFIX eco: <https://la3d-llm-agents.github.io/ns/eco#>
PREFIX ex: <urn:eco:example:>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK { ex:database eco:requiresAccess ?ssh, ?db . ?ssh eco:accessMechanism eco:SSHAuthentication ; eco:accessTarget "fabric.crc.nd.edu" . ?db eco:accessMechanism eco:DatabaseAuthentication ; eco:accessTarget "raredisease" . FILTER NOT EXISTS { ?ssh a eco:CredentialRequirement } }
